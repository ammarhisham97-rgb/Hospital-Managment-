using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Design;

namespace Hospital_Managment_system.Data;

/// <summary>
/// Design-time factory for creating DbContext instances.
/// Used by EF Core CLI tools (add-migration, update-database, etc.)
/// </summary>
public class AppDbContextFactory : IDesignTimeDbContextFactory<AppDbContext>
{
    public AppDbContext CreateDbContext(string[] args)
    {
        var optionsBuilder = new DbContextOptionsBuilder<AppDbContext>();
        var connectionString = "Server=(local);Database=HospitalManagementDb;Trusted_Connection=true;TrustServerCertificate=true;";

        optionsBuilder.UseSqlServer(connectionString);

        return new AppDbContext(optionsBuilder.Options);
    }
}
